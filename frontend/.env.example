# Copy to .env (or .env.local) and fill in real values.
# All VITE_* vars are compiled into the browser bundle — never put a secret here.
# See tutorial.md at the repo root for where each value comes from.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_CLIENT_ID=

# Base URL of the backend API (no trailing slash), e.g. http://localhost:3001
VITE_API_URL=http://localhost:3001
