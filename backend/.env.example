PORT=3001

# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional override; defaults to gemini-2.5-flash if unset
GEMINI_MODEL=gemini-2.5-flash

# Shared secret you choose yourself. Pass it as the `token` field when
# registering a Drive watch channel — Google echoes it back on every push
# notification via X-Goog-Channel-Token so the webhook can verify the
# request actually came from your channel.
GOOGLE_DRIVE_WEBHOOK_TOKEN=
