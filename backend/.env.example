# Copy to backend/.env and fill in. NEVER commit the real .env — see ForDev.md.

NODE_ENV=development
PORT=3001

# --- Gemini (Google AI Studio: https://aistudio.google.com/apikey) ---------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Inline-request ceiling; larger files are skipped rather than uploaded.
MAX_IMAGE_BYTES=18874368

# --- Google Cloud OAuth client (Drive access) -----------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI on the OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# --- Drive push notifications ---------------------------------------------
# Public HTTPS URL Google posts to. In dev this is your ngrok URL.
DRIVE_WEBHOOK_URL=https://your-subdomain.ngrok-free.app/webhook/drive
# Any long random string you choose; Drive echoes it back for verification.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_DRIVE_WEBHOOK_TOKEN=

# --- Supabase -------------------------------------------------------------
SUPABASE_URL=
# service_role key — server-side only, bypasses RLS. Never ship to a browser.
SUPABASE_SERVICE_ROLE_KEY=
# anon/public key — not secret, only used by scripts/get-token.js for local testing.
SUPABASE_ANON_KEY=

# --- Application secrets --------------------------------------------------
# 32 bytes hex. Encrypts Google refresh tokens at rest. Rotating it makes
# existing stored tokens undecryptable (users must reconnect Drive).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
# Signs the OAuth `state` parameter.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_STATE_SECRET=

# --- Frontend -------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Free-trial length granted on first Drive connect.
TRIAL_DAYS=14
