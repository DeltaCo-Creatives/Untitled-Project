{
  "_comment": "Shared by backend/src/utils/filename.js and frontend/src/lib/filename.ts. Both must produce exactly these results. Every vector may set \"kind\": \"image\" | \"document\"; omitting it means \"image\", so every vector written before document processes existed still means what it always did. A render vector's \"values\" may hold either kind's fields (see NameValues); render never validates a token, it just looks the value up, so unused-kind fields are simply ignored. A validate vector may set \"message\": when present, that exact string must appear somewhere in validateTemplate's returned error array (there may be others), used to pin down the cross-kind hint and the per-kind \"add a token\" hint wording.",
  "render": [
    {
      "name": "legacy template keeps today's names",
      "template": "{genre}_{subject}",
      "values": { "genre": "portrait", "subject": "woman-smiling" },
      "originalName": "IMG_0042.JPG",
      "mimeType": "image/jpeg",
      "expected": "portrait_woman-smiling.jpg"
    },
    {
      "name": "destination, subject and date",
      "template": "{destination}_{subject}_{date}",
      "values": { "destination": "Line art", "subject": "Acme wordmark", "date": "2026-09-17" },
      "originalName": "logo final.png",
      "mimeType": "image/png",
      "expected": "line-art_acme-wordmark_2026-09-17.png"
    },
    {
      "name": "an empty token takes its separator with it",
      "template": "{destination}_{style}_{subject}",
      "values": { "destination": "Logos", "style": "", "subject": "coffee cup" },
      "originalName": "",
      "mimeType": "image/webp",
      "expected": "logos_coffee-cup.webp"
    },
    {
      "name": "two leading empty tokens",
      "template": "{style}_{genre}_{subject}",
      "values": { "style": "", "genre": "", "subject": "red car" },
      "originalName": "a.jpg",
      "mimeType": "image/jpeg",
      "expected": "red-car.jpg"
    },
    {
      "name": "accents are folded",
      "template": "{subject}",
      "values": { "subject": "Über Café" },
      "originalName": "x.heic",
      "mimeType": "image/heic",
      "expected": "uber-cafe.heic"
    },
    {
      "name": "everything empty falls back to image",
      "template": "{style}-{genre}",
      "values": { "style": "", "genre": "", "subject": "  " },
      "originalName": "noext",
      "mimeType": "image/png",
      "expected": "image.png"
    },
    {
      "name": "empty template result falls back to subject",
      "template": "{style}",
      "values": { "style": "", "subject": "red car" },
      "originalName": "a.gif",
      "mimeType": "image/gif",
      "expected": "red-car.gif"
    },
    {
      "name": "custom tag field and literal parentheses",
      "template": "{tag:client}_{subject} ({date})",
      "values": { "subject": "banner", "date": "2026-01-02", "tags": { "client": "Acme Co." } },
      "originalName": "b.jpeg",
      "mimeType": "image/jpeg",
      "expected": "acme-co_banner (2026-01-02).jpeg"
    },
    {
      "name": "missing custom tag value",
      "template": "{tag:client}_{subject}",
      "values": { "subject": "banner", "tags": {} },
      "originalName": "b.jpg",
      "mimeType": "image/jpeg",
      "expected": "banner.jpg"
    },
    {
      "name": "original drops its extension",
      "template": "{original}-{destination}",
      "values": { "original": "Client Upload 01.PNG", "destination": "Graphics" },
      "originalName": "Client Upload 01.PNG",
      "mimeType": "image/png",
      "expected": "client-upload-01-graphics.png"
    },
    {
      "name": "a deliberate spaced dash is kept",
      "template": "{destination} - {subject}",
      "values": { "destination": "Logos", "subject": "cat" },
      "originalName": "c.jpg",
      "mimeType": "image/jpeg",
      "expected": "logos - cat.jpg"
    },
    {
      "name": "a spaced dash disappears with its empty token",
      "template": "{destination} - {subject}",
      "values": { "destination": "", "subject": "cat" },
      "originalName": "c.jpg",
      "mimeType": "image/jpeg",
      "expected": "cat.jpg"
    },
    {
      "name": "stray characters in an unvalidated template are replaced",
      "template": "{subject}/{style}",
      "values": { "subject": "cat", "style": "photo" },
      "originalName": "",
      "mimeType": "image/tiff",
      "expected": "cat-photo.tif"
    },
    {
      "name": "150 character cap",
      "template": "{subject}_{style}_{genre}",
      "values": {
        "subject": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "style": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "genre": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
      },
      "originalName": "x.jpg",
      "mimeType": "image/jpeg",
      "expected": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa_bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb_cccccccccccccccccccccccccccc.jpg"
    },
    {
      "name": "cap landing on a separator trims it",
      "template": "{subject}{style}{genre}_{process}",
      "values": {
        "subject": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "style": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "genre": "ccccccccccccccccccccccccccccc",
        "process": "zzz"
      },
      "originalName": "q.png",
      "mimeType": "image/png",
      "expected": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaabbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbccccccccccccccccccccccccccccc.png"
    },
    {
      "name": "slug cut at 60 doesn't end in a hyphen",
      "template": "{subject}",
      "values": { "subject": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa b" },
      "originalName": "x.jpg",
      "mimeType": "image/jpeg",
      "expected": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.jpg"
    },
    {
      "name": "junk extension falls back to the MIME type",
      "template": "{subject}",
      "values": { "subject": "dog" },
      "originalName": "photo.jpg?raw=1",
      "mimeType": "image/jpeg",
      "expected": "dog.jpg"
    },
    {
      "name": "a leading dot is not an extension",
      "template": "{subject}",
      "values": { "subject": "dog" },
      "originalName": ".hidden",
      "mimeType": "image/png",
      "expected": "dog.png"
    },
    {
      "name": "document: the default template names type, organization and topic",
      "template": "{type}_{organization}_{topic}",
      "values": { "type": "Invoice", "organization": "Acme Corp", "topic": "March renewal" },
      "originalName": "invoice.pdf",
      "mimeType": "application/pdf",
      "kind": "document",
      "expected": "invoice_acme-corp_march-renewal.pdf"
    },
    {
      "name": "document: a docx keeps its extension",
      "template": "{type}_{topic}",
      "values": { "type": "Contract", "topic": "Vendor Agreement" },
      "originalName": "Vendor Agreement.docx",
      "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "kind": "document",
      "expected": "contract_vendor-agreement.docx"
    },
    {
      "name": "document: a Google Doc keeps no extension",
      "template": "{type}_{topic}",
      "values": { "type": "Meeting", "topic": "Roadmap Notes" },
      "originalName": "Roadmap Notes",
      "mimeType": "application/vnd.google-apps.document",
      "kind": "document",
      "expected": "meeting_roadmap-notes"
    },
    {
      "name": "document: an empty organization drops its separator",
      "template": "{type}_{organization}_{topic}",
      "values": { "type": "Invoice", "organization": "", "topic": "March" },
      "originalName": "doc.pdf",
      "mimeType": "application/pdf",
      "kind": "document",
      "expected": "invoice_march.pdf"
    },
    {
      "name": "document: docdate renders like any other token",
      "template": "{type}_{docdate}",
      "values": { "type": "Invoice", "docdate": "2026-03-01" },
      "originalName": "x.pdf",
      "mimeType": "application/pdf",
      "kind": "document",
      "expected": "invoice_2026-03-01.pdf"
    },
    {
      "name": "document: date is shared with image processes",
      "template": "{type}_{date}",
      "values": { "type": "Invoice", "date": "2026-09-19" },
      "originalName": "x.pdf",
      "mimeType": "application/pdf",
      "kind": "document",
      "expected": "invoice_2026-09-19.pdf"
    },
    {
      "name": "document: a custom tag field",
      "template": "{tag:client}_{type}",
      "values": { "type": "Invoice", "tags": { "client": "Acme Co." } },
      "originalName": "x.pdf",
      "mimeType": "application/pdf",
      "kind": "document",
      "expected": "acme-co_invoice.pdf"
    },
    {
      "name": "document: everything empty falls back to document",
      "template": "{organization}-{type}",
      "values": { "organization": "", "type": "", "topic": "   " },
      "originalName": "noext",
      "mimeType": "application/pdf",
      "kind": "document",
      "expected": "document.pdf"
    }
  ],
  "validate": [
    { "template": "{destination}_{subject}", "tagKeys": [], "valid": true },
    { "template": "{subject}_{tag:client}", "tagKeys": ["client"], "valid": true },
    { "template": "{ subject }", "tagKeys": [], "valid": true },
    { "template": "{subject}_{tag:client}", "tagKeys": [], "valid": false },
    { "template": "{subjct}", "tagKeys": [], "valid": false },
    { "template": "no tokens here", "tagKeys": [], "valid": false },
    { "template": "{subject", "tagKeys": [], "valid": false },
    { "template": "subject}", "tagKeys": [], "valid": false },
    { "template": "{subject}/{style}", "tagKeys": [], "valid": false },
    { "template": "", "tagKeys": [], "valid": false },
    { "template": "{destination}_{subject}", "tagKeys": [], "kind": "image", "valid": true },
    {
      "template": "no tokens here",
      "tagKeys": [],
      "kind": "image",
      "valid": false,
      "message": "Add at least one token, like {subject}, so files don't all get the same name."
    },
    { "template": "{type}_{organization}_{topic}", "tagKeys": [], "kind": "document", "valid": true },
    { "template": "{topic}_{tag:client}", "tagKeys": ["client"], "kind": "document", "valid": true },
    { "template": "{docdate}_{type}", "tagKeys": [], "kind": "document", "valid": true },
    { "template": "{topic}_{tag:client}", "tagKeys": [], "kind": "document", "valid": false },
    {
      "template": "no tokens here",
      "tagKeys": [],
      "kind": "document",
      "valid": false,
      "message": "Add at least one token, like {topic}, so files don't all get the same name."
    },
    {
      "template": "{genre}",
      "tagKeys": [],
      "kind": "document",
      "valid": false,
      "message": "{genre} is an image token; document processes use {type}, {topic} or {organization}."
    },
    {
      "template": "{type}",
      "tagKeys": [],
      "kind": "image",
      "valid": false,
      "message": "{type} is a document token; image processes use {subject}, {style} or {genre}."
    },
    { "template": "{subjct}", "tagKeys": [], "kind": "document", "valid": false }
  ]
}
