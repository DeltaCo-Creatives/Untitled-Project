GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Make sure this matches the redirect URI in your Google Cloud Console exactly!
GOOGLE_REDIRECT_URI=http://localhost:8888/.netlify/functions/auth-callback

# You will get this from testing the OAuth flow in the browser
GOOGLE_REFRESH_TOKEN=your_refresh_token_here

# Get these from the URLs of your Google Drive folders
GOOGLE_DRIVE_RAW_FOLDER_ID=your_raw_folder_id_here
GOOGLE_DRIVE_SORTED_FOLDER_ID=your_sorted_folder_id_here

# For testing the webhook script
WEBHOOK_URL=https://your-app.netlify.app/.netlify/functions/webhook-drive
